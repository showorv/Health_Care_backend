{
  "compilerOptions": {
    "module": "esnext",   
     "moduleResolution": "bundler",                             
    "rootDir": "./src",
    "outDir": "./dist",  
      "target": "ES2023",
    // "moduleResolution": "node10", 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
     "ignoreDeprecations": "6.0"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}

